# Copy this file to .env and fill in real values before running the server.

# Port the API listens on.
PORT=3001

# Long, random string used to sign login sessions (JWTs). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string

# Comma-separated list of origins allowed to call this API.
# Include your local dev server and your deployed frontend URL.
CORS_ORIGIN=http://localhost:5173,https://thehonoredone672.github.io

# The account below is created (or promoted to admin) automatically on
# server startup, so you always have a way into the admin dashboard.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=change-this-strong-password

# Where the JSON data file is written. Must be on persistent storage —
# see server/README.md for notes on specific hosts.
DB_PATH=./data.json
